[flex]
  "Languages"
  [grid] "ReactPythonJavaGo"
    [row] "React"
      [gridcell] "React"
        "React"
        @e1 [button] "Remove"
    [row] "Python"
      [gridcell] "Python"
        "Python"
        @e2 [button] "Remove"
    [row] "Java"
      [gridcell] "Java"
        "Java"
        @e3 [button] "Remove"
    [row] "Go"
      [gridcell] "Go"
        "Go"
        @e4 [button] "Remove"
  "Tags: ['React', 'Python', 'Java', 'Go']"
  @e5 [button] "Reset"